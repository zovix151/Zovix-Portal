{
  "1": {
    "inputs": {
      "image": "input_face.png",
      "upload": "image"
    },
    "class_type": "LoadImage",
    "_meta": {
      "title": "Global Source Face Image"
    }
  },
  "2": {
    "inputs": {
      "audio_path": "input_dialogue.wav",
      "stream_index": 0
    },
    "class_type": "LoadAudio",
    "_meta": {
      "title": "Global Audio / TTS Stream"
    }
  },
  "3": {
    "inputs": {
      "insightface_model": "antelopev2",
      "detection_bbox_detector": "yolov8n",
      "face_restore_model": "CodeFormer"
    },
    "class_type": "LivePortraitLoadModel",
    "_meta": {
      "title": "LivePortrait Model & Face Analysis"
    }
  },
  "4": {
    "inputs": {
      "source_image": ["1", 0],
      "driven_audio": ["2", 0],
      "model": ["3", 0],
      "do_crop": true,
      "scale": 2.3,
      "vx_ratio": 0.0,
      "vy_ratio": -0.125
    },
    "class_type": "LivePortraitNode",
    "_meta": {
      "title": "Advanced LivePortrait Execution Engine"
    }
  },
  "5": {
    "inputs": {
      "frame_rate": 25,
      "loop_count": 0,
      "filename_prefix": "Zovix_WorldClass_Studio",
      "format": "video/h264-mp4",
      "pix_fmt": "yuv420p",
      "crf": 19,
      "save_metadata": true,
      "images": ["4", 0]
    },
    "class_type": "VHS_VideoCombine",
    "_meta": {
      "title": "Video Helper Suite (High-FPS Export)"
    }
  }
}